# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required -----------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# --- Optional: provider -------------------------------------------------
# gemini (default) | mock  — `mock` runs the whole loop offline with no key.
LF_PROVIDER=gemini

# --- Optional: models ---------------------------------------------------
# Run `lessonforge models` to list what your key actually has access to.
# The judge is intentionally a separate call from the generator; see
# ARCHITECTURE.md "Judge independence".
#
# Defaults are flash-tier because free Google AI Studio keys have zero quota
# for every pro-tier model (429) and gemini-2.5-pro returns 404.
# Defaults target a FREE AI Studio key. On the free tier gemini-3.6-flash and
# gemini-3.5-flash allow only a handful of calls per day, and one full run needs
# 3-7 — so the loop dies at `generate` with a 429 and evaluates nothing.
# flash-lite has real headroom and runs the whole loop live.
# Tradeoff: lite is a marginal writer, so it trips a blocking check more often;
# roughly 1 run in 3 rejects. That is the gate working, not a bug.
# On a paid key, put generator and judge back on gemini-3.6-flash.
LF_GENERATOR_MODEL=gemini-3.1-flash-lite
LF_PLANNER_MODEL=gemini-3.1-flash-lite
LF_JUDGE_MODEL=gemini-3.1-flash-lite
LF_REFLECTOR_MODEL=gemini-3.1-flash-lite

# Quota tip: `lessonforge verify` makes 7 judge calls back to back and will
# exhaust a free-tier per-minute limit. It draws from a separate pool, so:
#     lessonforge verify --judge-model gemini-3.1-flash-lite
# The lite model has been checked against every injection and catches all six.

# --- Optional: sampling -------------------------------------------------
LF_GENERATOR_TEMPERATURE=0.7
# The judge runs at 0.0 on purpose: a rubric that returns different verdicts
# for identical input is not a rubric.
LF_JUDGE_TEMPERATURE=0.0
LF_MAX_OUTPUT_TOKENS=16000

# --- Optional: paths ----------------------------------------------------
LF_MEMORY_DB=memory/lessonforge.db
LF_OUTPUT_DIR=output
